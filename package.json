{
  "name": "apex-dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.tools.json",
    "mcp:start": "node .mcp/servers/apex-api-server.js",
    "mcp:test": "node -e \"import('./src/services/mcpClient.ts').then(m => m.mcpClient.getTournaments().then(console.log))\"",
    "mcp:inspect": "npx @modelcontextprotocol/inspector",
    "mcp:servers": "echo 'Available MCP servers: filesystem, apex-api'",
    "test:browser": "node --experimental-strip-types scripts/tests/workspace.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gsap": "^3.13.0",
    "pinia": "^3.0.3",
    "pinia-colada": "^0.0.1",
    "vue": "3.5.44",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@modelcontextprotocol/server-filesystem": "^2025.7.1",
    "@modelcontextprotocol/server-memory": "^2025.4.25",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.7.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/ui": "4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.0.46",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "jsdom": "^26.1.0",
    "playwright": "1.55.1",
    "postcss": "8.5.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "vue-tsc": "^3.0.3"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "9.0.7"
    }
  }
}
