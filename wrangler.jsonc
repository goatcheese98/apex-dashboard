{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apex-dashboard-static-option",
  "main": "deploy/static.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
