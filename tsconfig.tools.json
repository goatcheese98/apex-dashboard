{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "eslint.config.ts",
    "scripts/tests/**/*.ts",
    "vite.config.ts",
    "deploy/**/*.ts",
    "scripts/cloudflare.ts"
  ]
}
